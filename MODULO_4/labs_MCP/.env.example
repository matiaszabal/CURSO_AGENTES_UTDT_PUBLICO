# Copiá este archivo a `.env` (en esta misma carpeta) y completá tus valores:
#   cp .env.example .env
# El archivo `.env` NO se sube al repositorio: nunca subas tus keys.

# --- Autenticación del modelo: Google AI Studio -------------------------------
# Conseguí una API key gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu-api-key-de-ai-studio
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo (opcional; por defecto gemini-2.5-flash)
# MODEL=gemini-2.5-flash

# --- Google Maps (SOLO para maps_agent y maps_agent_grounding_lite) ------------
# Los otros tres agentes no la necesitan. Ver la sección "API key de Google Maps" del README.
GOOGLE_MAPS_API_KEY=tu-api-key-de-maps
